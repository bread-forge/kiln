<mxfile>
  <diagram name="Graph Execution Pipeline" id="kiln-graph">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1500" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
